{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/extraccion.requiere_revision/v1.json",
  "title": "Extraccion Requiere Revision Event",
  "description": "Evento emitido cuando un documento es derivado a la cola HITL por fallo en score o validadores.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "documentId",
    "taskId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "extraccion.requiere_revision"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "typology": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$",
      "description": "Tipologia del oficio (opcional, metadato para review-service y quality-service)."
    },
    "blindSample": {
      "type": "boolean",
      "description": "true si la tarea proviene de muestreo ciego de un oficio auto-aprobado (opcional)."
    }
  },
  "additionalProperties": false
}