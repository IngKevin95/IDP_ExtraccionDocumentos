    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "requestedBy",
    "reason"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "tenant.baja_iniciada"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "requestedBy": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
