{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/tenant.baja_iniciada/v2.json",
  "title": "Tenant Baja Iniciada Event V2",
  "description": "Evento emitido cuando se solicita la eliminación lógica de un tenant, previo a la purga. V2 segregada y no modificable.",
  "type": "object",
