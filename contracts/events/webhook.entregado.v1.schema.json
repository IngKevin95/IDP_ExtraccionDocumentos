{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/webhook.entregado/v1.json",
  "title": "Webhook Entregado Event",
  "description": "Evento emitido cuando un webhook fue recibido con código HTTP 2xx por el sistema integrador.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "webhookId",
    "documentId",
    "attempts"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "webhook.entregado"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "webhookId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "latencyMs": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}