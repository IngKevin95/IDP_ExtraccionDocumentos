{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/chat.respuesta_desde_cache/v1.json",
  "title": "Chat Respuesta Desde Cache Event",
  "description": "Evento emitido cuando el chat RAG sirve una respuesta directamente desde la caché semántica.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "sessionId",
    "originalMessageId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "chat.respuesta_desde_cache"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "originalMessageId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}