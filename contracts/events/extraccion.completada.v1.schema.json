{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/extraccion.completada/v1.json",
  "title": "Extraccion Completada Event",
  "description": "Evento emitido cuando se aprueba exitosamente todas las extracciones de un documento, superando los umbrales.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "documentId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "extraccion.completada"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "typology": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$",
      "description": "Tipologia del oficio (opcional, metadato para quality-service)."
    },
    "modelPromptKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,120}$",
      "description": "Par modelo+prompt usado (opcional)."
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Latencia de la extraccion en milisegundos (opcional)."
    },
    "costMicros": {
      "type": "integer",
      "minimum": 0,
      "description": "Costo de la extraccion en micros de la moneda de facturacion (opcional)."
    }
  },
  "additionalProperties": false
}