{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/revision.completada/v1.json",
  "title": "Revision Completada Event",
  "description": "Evento emitido cuando una tarea de revisión manual humana ha finalizado (Aprobada o Rechazada).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "documentId",
    "taskId",
    "action",
    "reviewerId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "revision.completada"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "enum": [
        "APROBADO",
        "RECHAZADO"
      ]
    },
    "reviewerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Subject del revisor que cerro la tarea. El consumidor revalida su rol REVISOR vigente."
    },
    "secondReviewerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Segundo aprobador (distinto del primero), obligatorio si criticalCorrection es true."
    },
    "criticalCorrection": {
      "type": "boolean",
      "description": "true si hubo correccion de un campo critico (regla de cuatro ojos, SEC-009)."
    },
    "typology": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$",
      "description": "Tipologia del oficio (opcional, metadato para quality-service)."
    },
    "blindSample": {
      "type": "boolean",
      "description": "true si el oficio auto-aprobado fue forzado a revision ciega (muestreo ciego, quality-service)."
    },
    "correctedFields": {
      "type": "array",
      "maxItems": 64,
      "description": "Campos corregidos por el revisor. Solo nombre y tipo de correccion: jamas el valor (SEC-050).",
      "items": {
        "type": "object",
        "required": ["field", "correctionType"],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "correctionType": {
            "type": "string",
            "enum": ["VALOR", "FORMATO", "OMISION", "SOBRANTE"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}