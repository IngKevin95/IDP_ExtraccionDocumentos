{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/documento.purgado/v1.json",
  "title": "Documento Purgado Event",
  "description": "Evento de purga por Habeas Data para notificar eliminación del binario y disparar crypto-shredding. Sin PII (SEC-050).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "documentId",
    "purgedAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "documento.purgado"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "purgedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}