{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/cuota.umbral_alcanzado/v1.json",
  "title": "Cuota Umbral Alcanzado Event",
  "description": "Alerta sobre el nivel de consumo del tenant.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "metricName",
    "thresholdPercentage"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "cuota.umbral_alcanzado"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "metricName": {
      "type": "string"
    },
    "thresholdPercentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "additionalProperties": false
}