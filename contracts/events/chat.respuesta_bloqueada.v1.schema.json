{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.example/events/chat.respuesta_bloqueada/v1.json",
  "title": "Chat Respuesta Bloqueada Event",
  "description": "Evento emitido cuando una respuesta del chat documental es bloqueada.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "tenantId",
    "correlationId",
    "sessionId",
    "reasonCode"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "chat.respuesta_bloqueada"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "CONTENT_FILTER_TRIGGERED",
        "SEVERE_HALLUCINATION",
        "POLICY_VIOLATION"
      ]
    }
  },
  "additionalProperties": false
}